<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookshelf</title>
    <%= favicon_tag %>
    <%= stylesheet_tag "app" %>
  </head>
  <body>
    <nav class="navbar bg-body-tertiary mb-4">
      <div class="container">
        <a class="navbar-brand" href="<%= routes.path(:root) %>">Bookshelf</a>
        <a class="nav-link" href="<%= routes.path(:books) %>">Books</a>
      </div>
    </nav>
    <main class="container">
      <% if flash[:alert] %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>
      <%= yield %>
    </main>
    <%= javascript_tag "app" %>
  </body>
</html>
