<h1>Edit Book</h1>

<%= form_for :book, routes.path(:book, id: book.id), method: :patch do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :author %>
    <%= f.text_field :author %>
  </div>
  <div>
    <%= f.submit "Update" %>
  </div>
<% end %>

