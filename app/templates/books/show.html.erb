<h1><%= book[:title] %></h1>
<p>Author: <%= book[:author] %></p>

<div>
  <%= form_for :book, routes.path(:book, id: book.id), method: :delete do |f| %>
    <%= f.submit "Delete" %>
  <% end %>
</div>

<h2>Reviews</h2>
<ul>
  <% book.reviews.each do |review| %>
    <li><%= review[:content] %></li>
  <% end %>
</ul>

<%= form_for :review, routes.path(:book_reviews, book_id: book.id) do |f| %>
  <div>
    <%= f.label :content %>
    <%= f.text_area :content %>
  </div>

  <div>
    <%= f.submit "Add Review" %>
  </div>
<% end %>
